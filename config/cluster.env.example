# Copy to config/cluster.env and fill in. cluster.env is gitignored.

# Public IPv4 of the OCI instance
PUBLIC_IP=
# Tailscale IP of the node
TS_IP=
# DuckDNS hostname for SafeDesk
HOST_SAFEDESK=
# DuckDNS hostname for MiniShop
HOST_MINISHOP=
# DuckDNS hostname for Relay
HOST_RELAY=
# Contact email for ACME / Let's Encrypt registration
ACME_EMAIL=
# K3s version to install (e.g. a v1.x.y+k3s1 tag)
K3S_VERSION=
