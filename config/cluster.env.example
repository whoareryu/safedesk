# Copy to config/cluster.env and fill in. cluster.env is gitignored.
# Public values are prefilled; private ones are blank on purpose.

# Deployment target. Only "local" (Lima VM + Cloudflare Tunnel) is implemented.
TARGET=local
# Public hostnames and zone (public values)
HOST_SAFEDESK=safedesk.whoareryu.cloud
HOST_MINISHOP=minishop.whoareryu.cloud
HOST_RELAY=relay.whoareryu.cloud
CF_ZONE=whoareryu.cloud
# Lima instance name (required when TARGET=local)
LIMA_INSTANCE=
# Cloudflare Tunnel name (required when TARGET=local)
TUNNEL_NAME=
# Contact email for ACME / Let's Encrypt registration (private)
ACME_EMAIL=
# K3s version to install (e.g. a v1.x.y+k3s1 tag)
K3S_VERSION=
# Tunnel UUID (private, optional; filled in once the tunnel exists)
TUNNEL_ID=
